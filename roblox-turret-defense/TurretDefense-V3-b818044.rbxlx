Shared.TIER_STATS = {
	{ dmg = 30,   cd = 0.55, range = 20, shots = 1, proj = "bullet", speed = 150, splash = 0 },
	{ dmg = 82,   cd = 0.50, range = 21, shots = 1, proj = "bullet", speed = 155, splash = 0 },
