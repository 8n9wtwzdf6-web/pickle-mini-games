		S.moveMode = true
		local cell = arenaModel and arenaModel:FindFirstChild("Cells")
		cell = cell and cell:FindFirstChild("Cell_" .. S.selected.col .. "_" .. S.selected.row)
		moveBox.Adornee = cell
